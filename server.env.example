PUBLIC_ORIGIN=http://localhost:3000
GOOGLE_CLIENT_ID=replace-with-web-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-web-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
POCKET_ID_ISSUER=https://auth.aries.timdumol.com
POCKET_ID_CLIENT_ID=presto-presupuesto-web
POCKET_ID_REDIRECT_URI=http://localhost:3000/auth/pocket-id/callback
POCKET_ID_ALLOWED_SUBJECTS=replace-with-comma-separated-pocket-id-subject-uuids
APPS_SCRIPT_DEPLOYMENT_ID=replace-with-api-executable-deployment-id
FINANCE_DB_READ_ENABLED=false
# Emergency recovery only: use the matching schema, keep every finance write
# flag false, then disable this again after a successful restore.
FINANCE_DB_RESTORE_ENABLED=false
FINANCE_DB_CLOSE_ENABLED=false
FINANCE_DB_CATEGORY_CORRECTIONS_ENABLED=false
FINANCE_DB_TRANSACTION_WRITES_ENABLED=false
FINANCE_DB_RECONCILIATION_WRITES_ENABLED=false
ALLOWED_EMAILS=owner@example.com,household@example.com
TOKEN_ENCRYPTION_KEY=replace-with-output-from-openssl-rand-base64-32
COOKIE_SECURE=false

# Optional partner notifications: path to a private service-account JSON, never bundled.
# FCM_SERVICE_ACCOUNT_FILE=/secure/path/presto-fcm.json
