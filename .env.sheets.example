# A full Google Sheets URL or the spreadsheet ID between /d/ and /edit.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_TEST_SPREADSHEET_ID=

# Change these to the tab names in your workbook.
GOOGLE_SHEETS_TRANSACTIONS_SHEET=Transactions
GOOGLE_SHEETS_BUDGETS_SHEET="Expenses v3"
GOOGLE_SHEETS_CREATED_BY=td_prestosupuesto

# OAuth desktop credentials and the locally cached refresh token.
GOOGLE_OAUTH_CREDENTIALS=.google/credentials.json
GOOGLE_OAUTH_TOKEN=.google/token.json
GOOGLE_APPS_SCRIPT_TOKEN=.google/apps-script-deployment-token.json
GOOGLE_CLOUD_ADMIN_TOKEN=.google/cloud-admin-token.json
GOOGLE_APPS_SCRIPT_DEPLOYMENT=.google/apps-script-deployment.json

# Alternative non-interactive authentication. Share the spreadsheet with the
# service account's client_email before using it.
# GOOGLE_APPLICATION_CREDENTIALS=.google/service-account.json
