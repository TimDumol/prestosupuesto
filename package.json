{
  "name": "prestosupuesto",
  "version": "1.4.0",
  "main": "index.ts",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.16",
    "expo-crypto": "~57.0.2",
    "expo-splash-screen": "~57.0.8",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-native": "0.86.2",
    "react-native-nitro-google-signin": "^2.1.0",
    "react-native-nitro-modules": "^0.37.0",
    "react-native-safe-area-context": "~5.7.0"
  },
  "devDependencies": {
    "@google-cloud/local-auth": "^2.1.0",
    "@types/react": "~19.2.2",
    "googleapis": "^176.0.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test:sheets": "node --test scripts/sheets/lib.test.mjs scripts/sheets/finance-schema.test.mjs",
    "sheets:auth": "node --env-file-if-exists=.env.sheets.local scripts/sheets/auth.mjs",
    "sheets:inspect": "node --env-file-if-exists=.env.sheets.local scripts/sheets/inspect.mjs",
    "sheets:structure": "node --env-file-if-exists=.env.sheets.local scripts/sheets/structure.mjs",
    "sheets:probe-ledger": "node --env-file-if-exists=.env.sheets.local scripts/sheets/probe-ledger.mjs",
    "sheets:test-transaction": "node --env-file-if-exists=.env.sheets.local scripts/sheets/test-transaction.mjs",
    "sheets:migrate-test-schema": "node --env-file-if-exists=.env.sheets.local scripts/sheets/migrate-test-schema.mjs",
    "gateway:deploy-test": "node --env-file-if-exists=.env.sheets.local scripts/gateway/deploy-test.mjs",
    "gateway:enable-api": "node --env-file-if-exists=.env.sheets.local scripts/gateway/enable-api.mjs",
    "gateway:call": "node --env-file-if-exists=.env.sheets.local scripts/gateway/call.mjs",
    "sheets:finance-snapshot": "node --env-file-if-exists=.env.sheets.local scripts/sheets/finance-snapshot.mjs",
    "sheets:read": "node --env-file-if-exists=.env.sheets.local scripts/sheets/read.mjs",
    "sheets:snapshot": "node --env-file-if-exists=.env.sheets.local scripts/sheets/snapshot.mjs",
    "sheets:append": "node --env-file-if-exists=.env.sheets.local scripts/sheets/append-record.mjs",
    "sheets:patch": "node --env-file-if-exists=.env.sheets.local scripts/sheets/patch-record.mjs",
    "prebuild:android": "expo prebuild --platform android",
    "apk:release:windows": "cd android && gradlew.bat assembleRelease",
    "sheets:migrate-live-schema": "node --env-file-if-exists=.env.sheets.local scripts/sheets/migrate-live-schema.mjs",
    "gateway:deploy-live": "node --env-file-if-exists=.env.sheets.local scripts/gateway/deploy-live.mjs",
    "gateway:promote-live": "node --env-file-if-exists=.env.sheets.local scripts/gateway/promote-live.mjs",
    "test:entry": "node --test --experimental-strip-types src/entryIntelligence.test.ts src/transactionCache.test.ts"
  },
  "private": true,
  "expo": {
    "doctor": {
      "reactNativeDirectoryCheck": {
        "exclude": [
          "react-native-nitro-google-signin"
        ]
      }
    }
  },
  "overrides": {
    "metro": "0.84.5",
    "metro-config": "0.84.5",
    "metro-transform-worker": "0.84.5",
    "xcode": {
      "uuid": "11.1.1"
    }
  }
}
